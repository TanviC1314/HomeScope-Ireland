# Copy to .env and adjust. NEVER commit the real .env file.
POSTGRES_USER=homescope
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=homescope
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# SQLAlchemy URL used by the loader, SQL runner, tests and the dashboard.
DATABASE_URL=postgresql+psycopg2://homescope:change_me_locally@localhost:5433/homescope

# Dashboard data backend: auto (use PostgreSQL if reachable, else processed CSVs) | postgres | csv
HOMESCOPE_DATA_BACKEND=auto
